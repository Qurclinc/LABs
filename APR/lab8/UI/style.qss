/* ===== Global ===== */
QWidget {
    background-color: #000000;
    color: #00ff00;
    font-family: Consolas;
}

/* ===== Labels ===== */
QLabel {
    color: #00ff00;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #001100;
    color: #00ff00;
    border: 2px solid #00ff00;
    border-radius: 8px;
    padding: 8px 16px;
    min-width: 120px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #003300;
}

QPushButton:pressed {
    background-color: #005500;
}

QPushButton:disabled {
    background-color: #000800;
    color: #008800;
    border-color: #008800;
}

/* ===== Frames / Panels ===== */
QFrame {
    background-color: #000000;
    border: 1px solid #00ff00;
    border-radius: 5px;
    padding: 10px;
    border: none;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: none;
    margin: 2px 0px;
}

QTabBar::tab {
    background-color: #001100;
    color: #00ff00;
    padding: 8px 16px;
    border: 1px solid #00ff00;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #003300;
}

QTabBar::tab:hover {
    background-color: #002200;
}

/* ===== MessageBoxes ===== */
QMessageBox {
    background-color: #000000;
}

QMessageBox QLabel {
    font-family: Consolas;
}

QMessageBox QPushButton {
    padding: 5px 15px;
}

#NoBorder,#header {
    border: none !important;
    background-color: transparent !important;
    padding: 0px !important;
    margin: 0px !important;
}

#MainLayout {
    border: 1px solid #00ff00;
}

/* ===== Progress Bar (Loader) ===== */
QProgressBar {
    border: 2px solid #00ff00;
    border-radius: 6px;
    background-color: #000000;
    height: 14px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #00ff00;
    width: 20px;
    margin: 1px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #003300,
        stop:0.5 #00ff00,
        stop:1 #003300
    );
}

QProgressBar {
    font-family: Consolas;
    font-size: 10px;
    color: #00ff00;
}
